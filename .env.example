# =============================================================================
# SHARED — set on BOTH Railway services (Next.js web + Socket.IO realtime)
# Must match across services where noted.
# =============================================================================

# MongoDB (web API + realtime auth / room checks)
MONGODB_URI=

# Public web origin — email links (web) + Socket.IO CORS fallback (realtime)
APP_URL=http://localhost:3000

# Preferred Socket.IO CORS origin (realtime). Use the exact browser web origin.
# On Railway realtime, set this to the production Next.js URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for Next → realtime POST /internal/emit (same value on both)
REALTIME_INTERNAL_SECRET=

# =============================================================================
# REALTIME SERVICE ONLY (Socket.IO)
# =============================================================================

# Local listen port. On Railway, prefer platform PORT (code already does).
REALTIME_PORT=4001

# =============================================================================
# WEB SERVICE ONLY (Next.js UI + REST/API) — not needed on realtime
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Resend email
RESEND_API_KEY=
EMAIL_FROM=

# AWS S3 (attachments / avatars)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI (optional model override)
OPENAI_API_KEY=
# OPENAI_MODEL=

# Next.js server → realtime emit base URL
REALTIME_URL=http://localhost:4001

# Browser Socket.IO URL (baked in at Next build — set before production build)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# Public support inbox (Settings + footer mailto)
NEXT_PUBLIC_SUPPORT_EMAIL=
