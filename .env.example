# TeamHub AI — environment template
# Copy to `.env.local` for local development. Never commit real secrets.
# On Vercel (Phase 8), set the same names in Project → Settings → Environment Variables.

# MongoDB Atlas connection string
MONGODB_URI=

# Public app origin (no trailing slash). Local: http://localhost:3000
# Production: https://your-domain.com  — used in verify/reset email links
APP_URL=http://localhost:3000

# Google OAuth (Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console redirect URI exactly
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. TeamHub <onboarding@resend.dev> (dev) or your domain (prod)
EMAIL_FROM=

# AWS S3 — chat attachments (see docs/channels/S3-SETUP.md)
# Create IAM user keys — never use root account keys
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Realtime Socket.IO (npm run realtime)
# REALTIME_PORT=4001
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side URL Next uses for notifyRealtime (no trailing slash)
REALTIME_URL=http://localhost:4001
# Shared secret: Next POST /internal/emit ↔ realtime process (generate a long random string)
REALTIME_INTERNAL_SECRET=
# Browser Socket.IO URL (T16 SocketProvider). Same host as REALTIME_URL locally.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
# Smoke (optional, prefer inline): SMOKE_SESSION_TOKEN=  SMOKE_CHANNEL_ID=

# OpenAI — Phase 7 AI assistant (server-only; never NEXT_PUBLIC_)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
